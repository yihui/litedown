+// Extra visual indentation stripped from the current content line relative to
+// the first content line of the block. Continuation lines of a paragraph or
+// heading have their leading indentation removed when the block content is
+// built, so source columns computed from positions in that buffer are short by
+// this amount. Returns 0 on the first line (where block_offset already accounts
+// for the indentation).
+static CMARK_INLINE int line_indent_delta(subject *subj) {
+  int k = subj->line - subj->base_line;
+  if (k > 0 && subj->line_offsets && k < subj->n_line_offsets)
+    return subj->line_offsets[k] - subj->line_offsets[0];
+  return 0;
+}
