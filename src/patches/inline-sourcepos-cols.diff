+// Record the visual column at which this content line begins (i.e. the amount
+// of leading indentation / block markers that were stripped before the content
+// was appended to node->content). The inline parser uses these to report
+// correct source columns on continuation lines; see adjust_column_for_line()
+// in inlines.c.
+static void record_line_offset(cmark_node *node, int column) {
+  if (node->n_line_offsets >= node->cap_line_offsets) {
+    int cap = node->cap_line_offsets ? node->cap_line_offsets * 2 : 8;
+    int *p = (int *)node->content.mem->realloc(node->line_offsets,
+                                               cap * sizeof(int));
+    node->line_offsets = p;
+    node->cap_line_offsets = cap;
+  }
+  node->line_offsets[node->n_line_offsets++] = column;
+}
