diff --git a/cmark/buffer.c b/cmark/buffer.c
index c7934e5..c9e4910 100644
--- a/cmark/buffer.c
+++ b/cmark/buffer.c
@@ -89,7 +89,9 @@ void cmark_strbuf_set(cmark_strbuf *buf, const unsigned char *data,
